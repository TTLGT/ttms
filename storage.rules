rules_version = '2';

// Mirrors firestore.rules: access is an explicit allowlist, not an email domain.
//
// Storage rules cannot read Firestore, so they cannot check the `allowedUsers`
// collection directly. Instead /api/auth/session stamps a `ttlAccess` custom
// claim on the account at sign-in, and that claim is what gates this bucket
// (driver's licenses, BOLs, invoices, PODs, carrier/shipper documents).
//
// Revoking someone in Settings clears the claim, revokes their refresh tokens
// and disables the account, so they cannot mint a new token. Their current ID
// token stays valid until it expires (max one hour) — Firestore cuts off
// immediately, Storage lags by that window.
service firebase.storage {
  match /b/{bucket}/o {
    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.ttlAccess == true;
    }

    match /{allPaths=**} {
      allow read, write: if isAllowedUser();
    }
  }
}
