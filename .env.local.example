# ─── Firebase Client SDK (public — safe to expose in browser) ───────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin SDK (server-only — NEVER prefix with NEXT_PUBLIC_) ───────
# Generate a service account key in Firebase Console → Project Settings → Service Accounts
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ─── E-Sign / Email (Resend) ─────────────────────────────────────────────────
# Sign up at resend.com → Domains → verify totaltransportlogistics.us → API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@totaltransportlogistics.us

# ─── Exact lane mileage (OPTIONAL — costs money per lookup) ──────────────────
# Leave blank. Orders work without it on the free built-in estimate, which is
# the default. Only fill this in once someone has decided to pay for the Google
# Routes API, and switch Settings → Operations → Lane Distance to "routes".
GOOGLE_MAPS_API_KEY=

# ─── GIFs in chat (OPTIONAL — free) ──────────────────────────────────────────
# From the KLIPY Partner Panel (partner.klipy.com), signed in as
# it@totaltransportlogistics.us. Without it chat works as normal and the GIFs
# side of the sticker picker says GIF search is not set up. Server-only: never
# prefix it NEXT_PUBLIC_, or it would be published inside the site.
KLIPY_API_KEY=

# ─── App URL (used to build the signing links in emails) ─────────────────────
# Leave it as localhost here. On this machine it is only ever used to make a
# link you click yourself.
#
# On the deployment it must be the real public address, exactly:
#   NEXT_PUBLIC_APP_URL=https://ttms.totaltransportlogistics.us
# No trailing slash, no "www.", https not http. See docs/deployment.md.
#
# NEXT_PUBLIC_ values are baked in when the app is BUILT, not read when it runs,
# so changing this on the host does nothing until you redeploy.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Daily celebrations post (Vercel only) ───────────────────────────────────
# Leave blank here. This is the shared secret Vercel sends with the scheduled
# call that posts birthdays and work anniversaries in the Everyone room, and it
# is only ever set on the deployment — add it in Vercel → Settings →
# Environment Variables as any long random string, and Vercel sends it on every
# cron run by itself.
#
# Without it the endpoint refuses every request, which is deliberate: an
# endpoint that writes to the whole company must not fall open when a variable
# is missing. See vercel.json and src/app/api/chat/celebrations/route.ts.
CRON_SECRET=
