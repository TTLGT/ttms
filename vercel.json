{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/chat/celebrations",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/celebration-calendar/cron",
      "schedule": "5 14 * * *"
    },
    {
      "path": "/api/attendance/cron/close",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/attendance/cron/alerts",
      "schedule": "*/15 12-23 * * 1-6"
    },
    {
      "path": "/api/task-reminders/cron",
      "schedule": "*/5 * * * *"
    }
  ]
}
