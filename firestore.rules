rules_version = '2';

// Access is an explicit allowlist, not an email domain.
//
// A Google account only reaches data if an admin created its
// `allowedUsers/{email}` entry (see Settings → Grant Access) and that entry is
// not suspended. Because the check is a live document lookup, removing or
// suspending the entry cuts off access on the very next request rather than
// when the user's ID token expires.
//
// The public e-sign flow (src/app/api/sign/[token]/route.ts) goes through the
// Admin SDK, which bypasses these rules entirely — no public rule needed here.
service cloud.firestore {
  match /databases/{database}/documents {

    // Keep in sync with BOOTSTRAP_ADMIN_EMAILS in src/lib/accessControl.ts.
    // These accounts are always allowed so an empty or broken allowlist can
    // never lock everyone out of the system.
    function isBootstrapAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'it@totaltransportlogistics.us',
          'operations@totaltransportlogistics.us',
          'dispatch@totaltransportlogistics.us'
        ];
    }

    function allowlistRef() {
      return /databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower());
    }

    // A suspended entry stays in the collection — it keeps the person's roles
    // so access can be restored — so existence alone is no longer enough.
    // This has to be checked here rather than left to the disabled Auth account:
    // rules cannot see `disabled`, and an ID token minted before the suspension
    // stays valid for up to an hour.
    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email != null
        && (
          isBootstrapAdmin()
          || (
            exists(allowlistRef())
            && get(allowlistRef()).data.get('suspended', false) != true
          )
        );
    }

    function isAdmin() {
      return isAllowedUser() && (
        isBootstrapAdmin() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        )
      );
    }

    // One lookup, reused for every role flag. Reading the profile once keeps
    // the evaluation inside Firestore's per-request document-access limit, and
    // `.get(field, false)` tolerates profiles where the optional dispatcher,
    // finance and hr flags were never written — indexing a missing key errors
    // out and would deny the request outright.
    function profileData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Read-only access to the people directory. Keep in sync with
    // canSeeDirectory() in src/lib/accessControl.ts.
    //
    // Deliberately NOT part of canSeeAllParties() below: HR reads the staff
    // directory and nothing else. A payroll clerk must not inherit every
    // broker's book of business by being given a role named after a filing
    // cabinet.
    function isHr() {
      return isAllowedUser()
        && hasProfile()
        && profileData().get('isHr', false) == true;
    }

    // Keep in sync with canSeeAllParties() in src/lib/accessControl.ts.
    function canSeeAllParties() {
      return isAllowedUser() && (
        isBootstrapAdmin() || (
          hasProfile() && (
            profileData().get('isAdmin', false) == true
            || profileData().get('isDispatcher', false) == true
            || profileData().get('isFinance', false) == true
          )
        )
      );
    }

    // A party is visible to its owners, to the privileged roles, and to
    // everyone when nobody owns it. Defaults keep the check safe on documents
    // written before these fields existed.
    function partyVisible() {
      return canSeeAllParties()
        || (request.auth.uid in resource.data.get('assignedToUids', []))
        // Group ownership is tested against the membership mirrored onto the
        // user's profile. Rules cannot query, so without that mirror this would
        // need one document read per owning group.
        || resource.data.get('assignedToGroupIds', []).hasAny(
             hasProfile() ? profileData().get('groupIds', []) : []
           )
        || (
          resource.data.get('assignedToUids', []).size() == 0
          && resource.data.get('assignedToGroupIds', []).size() == 0
          // A party held for somebody who has not signed in yet is owned, not
          // unowned. Leaving this out would publish their book of business to
          // the whole company until the day they first logged in.
          && resource.data.get('assignedToEmails', []).size() == 0
          && resource.data.get('assignedToName', '') == ''
        );
    }

    // Keep in sync with canSeeOrder() in src/lib/accessControl.ts.
    //
    // Deliberately stricter than partyVisible(): there is no "nobody owns it,
    // so everybody can see it" branch. An unowned party is usually a facility
    // nobody has claimed and is harmless to share; an unowned order is a live
    // load with rates on it, so it stays with admin, dispatch and finance until
    // somebody is assigned to it.
    function orderVisible() {
      return canSeeAllParties()
        || (request.auth.uid in resource.data.get('assignedToUids', []))
        || (request.auth.uid in resource.data.get('clientOwnerUids', []))
        || resource.data.get('assignedToGroupIds', []).hasAny(
             hasProfile() ? profileData().get('groupIds', []) : []
           )
        // Owning the client carries every one of its orders. Rules cannot run
        // the query that would answer this, and a get() on the client party
        // per order would blow the document-access limit on any list, so the
        // client's owners are mirrored onto the order by syncClientOwners().
        || resource.data.get('clientOwnerGroupIds', []).hasAny(
             hasProfile() ? profileData().get('groupIds', []) : []
           );
    }

    // Ownership decides who can read a record, so it must not be writable by
    // the same people who can read it — otherwise anyone who could see an
    // unowned client could claim it and shut everybody else out, silently.
    // All ownership changes go through /api/{orders,parties}/{id}/owners,
    // which is admin- and dispatcher-only and writes the history entry in the
    // same batch.
    function ownershipUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Whether this write leaves the lead source alone. Source is attribution —
    // it decides whose campaign or referral gets credited for a load — so it is
    // held to a narrower test than the rest of the record below.
    function sourceUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['sourceId', 'sourceName']);
    }

    // Keep in sync with canEditSource() in src/lib/accessControl.ts.
    //
    // Narrower than "can edit this record" on purpose. Anyone who can see an
    // order can edit it, which takes in dispatch and finance, but changing what
    // a load is attributed to belongs to the people who own the relationship,
    // plus admins who have to be able to correct a mistake. A record nobody
    // owns therefore leaves only an admin able to set it — which falls out of
    // the rule rather than being a special case, and errs closed.
    function canEditSource() {
      return isAdmin()
        || (request.auth.uid in resource.data.get('assignedToUids', []))
        || resource.data.get('assignedToGroupIds', []).hasAny(
             hasProfile() ? profileData().get('groupIds', []) : []
           );
    }

    // The allowlist itself: readable by admins so Settings can render it, and
    // by HR, who need the payroll fields these entries carry (legal name, date
    // of birth, personal email, start date) and have no other way to reach
    // them. Read only — HR cannot write here any more than anyone else can.
    //
    // Never writable from the client. All changes go through
    // /api/admin/users, which also updates Firebase Auth (claims, revocation).
    match /allowedUsers/{email} {
      allow read:  if isAdmin() || isHr();
      allow write: if false;
    }

    // Profiles are provisioned server-side by /api/auth/session from the
    // allowlist entry. Client writes are closed so an uninvited account cannot
    // create a profile for itself, and nobody can self-promote to admin.
    match /users/{userId} {
      allow read:  if isAllowedUser();
      allow write: if false;
    }

    // The removal log: who was taken off the system, when, and by whom.
    // It keeps the departed person's date of birth and personal email, so it
    // is closed to the client SDK outright — admins read it through
    // /api/admin/users/removed, which guards on isAdmin server-side. Do not
    // open this up to make a client query work; route it instead.
    match /removedUsers/{removalId} {
      allow read, write: if false; // Admin SDK only
    }

    // Parties (clients, shippers, consignees) are owned records, not shared
    // reference data. A user sees one only if they own it, or if nobody owns it
    // at all; admin, dispatch and finance see everything.
    //
    // These rules are the floor, not the whole story. The app reads parties
    // through /api/parties, which applies the same test with the Admin SDK and
    // additionally lends visibility for an approved access request — something
    // rules cannot express without a query. Direct client reads are still
    // gated here so a bypass of the API gains nothing.
    //
    // Creates go through /api/parties so the name-collision check can see
    // records the caller cannot; the client path is closed.
    match /parties/{partyId} {
      allow read:   if isAllowedUser() && partyVisible();
      allow create: if false;
      allow update: if isAllowedUser() && partyVisible() && ownershipUnchanged([
        'assignedToUids', 'assignedToGroupIds', 'assignedToEmails', 'assignedToName'
      ]) && (sourceUnchanged() || canEditSource());
      allow delete: if isAdmin();


      // See the same block under /orders for why this is closed rather than
      // gated on partyVisible(). Read through GET /api/parties/{id}/owners.
      match /ownerEvents/{eventId} {
        allow read, write: if false; // Admin SDK only
      }
    }

    // Access requests and the probe log are written only by the API routes,
    // which capture the approver's IP from request headers. A client-side write
    // could forge the audit trail, so all writes are closed here.
    match /partyAccessRequests/{requestId} {
      allow read: if isAllowedUser() && (
        isAdmin()
        || resource.data.requestedByUid == request.auth.uid
        || (request.auth.uid in resource.data.get('ownerUids', []))
      );
      allow write: if false;
    }

    // The order-side equivalent. Same read rule and the same closed writes, for
    // the same reason: the decision carries the approver's IP, taken from the
    // request headers, and a client-side write could forge that trail.
    //
    // Note what this collection can do that the rules cannot see: an approved
    // request lends read access to one order. That grant is applied in
    // /api/orders only — orderVisible() below knows nothing about it. Safe
    // because orders are never read through the client SDK; anything that
    // starts doing so would bypass the grant and must not be added.
    match /orderAccessRequests/{requestId} {
      allow read: if isAllowedUser() && (
        isAdmin()
        || resource.data.requestedByUid == request.auth.uid
        || (request.auth.uid in resource.data.get('ownerUids', []))
      );
      allow write: if false;
    }

    // Sites are reference data — where someone works, not what they can see.
    // Readable by everyone signed in so a site name can be shown next to a
    // person; written only through /api/sites, which detaches users on delete.
    match /sites/{siteId} {
      allow read:  if isAllowedUser();
      allow write: if false;
    }

    // Lead sources are reference data — where a client or a load came from.
    // Readable by everyone signed in so a picker can render and a record can
    // show its source label; written only through /api/lead-sources, which is
    // admin-only and refuses to delete a source anything still points at.
    // Note the asymmetry: reading the *list* grants nothing, but setting a
    // source *on a record* is restricted — see canEditSource() above.
    match /leadSources/{sourceId} {
      allow read:  if isAllowedUser();
      allow write: if false;
    }

    // Teams are reference data too — who someone reports to. Note that nothing
    // anywhere in this file reads teamId: a team is an org chart, not an access
    // boundary, and work groups below are the thing that shares records. Do not
    // start gating visibility on a team; that is what work groups are for.
    // Written only through /api/teams, which detaches users on delete.
    match /teams/{teamId} {
      allow read:  if isAllowedUser();
      allow write: if false;
    }

    // Work groups are readable by any signed-in user so pickers can show names,
    // but membership is written only by /api/work-groups, which keeps each
    // member's users/{uid}.groupIds mirror in step inside a transaction.
    // A client-side write could grant itself access to another group's records.
    match /workGroups/{groupId} {
      allow read:  if isAllowedUser();
      allow write: if false;
    }

    // Company-wide settings. Everyone reads them — a broker's order form has
    // to know whether to show a lane distance — but only /api/app-settings
    // writes, and only for an admin.
    match /appSettings/{settingId} {
      allow read:  if isAllowedUser();
      allow write: if false;
    }

    match /partyAccessProbes/{probeId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /shippers/{shipperId} {
      allow read:   if isAllowedUser() && (
        isAdmin() || (resource.data.assignedToUids is list && request.auth.uid in resource.data.assignedToUids)
      );
      allow create: if isAllowedUser();
      allow update, delete: if isAllowedUser();

    }

    match /customers/{customerId} {
      allow read:   if isAllowedUser() && (
        isAdmin() || (resource.data.assignedToUids is list && request.auth.uid in resource.data.assignedToUids)
      );
      allow create: if isAllowedUser();
      allow update, delete: if isAllowedUser();
    }

    match /carriers/{carrierId} {
      allow read, create, update, delete: if isAllowedUser();

    }

    // Orders are owned records, like parties — but closed by default. See
    // orderVisible() above for why an order with no owner stays with the
    // privileged roles instead of falling open to everyone.
    //
    // As with parties, these rules are the floor. The app reads orders through
    // /api/orders, which applies canSeeOrder() with the Admin SDK; a client-SDK
    // query over this collection cannot express "mine, my groups', or my
    // clients'" in a form these rules could approve, so the API is the only
    // read path the app actually uses. This stays here so bypassing it gains
    // nothing.
    match /orders/{orderId} {
      allow read: if isAllowedUser() && orderVisible();

      // The creator has to be on the order. Orders are closed by default, so
      // an order created without an owner would be invisible to the person who
      // just wrote it.
      allow create: if isAllowedUser()
        && (request.auth.uid in request.resource.data.get('assignedToUids', []));

      allow update: if isAllowedUser() && orderVisible() && ownershipUnchanged([
        'assignedToUids', 'assignedToGroupIds', 'assignedToEmails',
        'clientOwnerUids', 'clientOwnerGroupIds', 'assignedTo'
      ]) && (sourceUnchanged() || canEditSource());

      allow delete: if isAdmin();

      // There is deliberately no `documents` subcollection rule here, nor under
      // parties or carriers. docs/schema-guide.md describes one, but it was
      // never built: attachments are Firebase Storage files, and the order
      // holds the path to each in bolStoragePath / invoiceStoragePath /
      // podStoragePath / driverLicenseStoragePath. Rules once existed for the
      // subcollection anyway and granted every signed-in user read and write on
      // it — an open door on an empty room. Do not re-add them for a
      // collection nothing writes to.
      //
      // Note that restricting an order here does NOT restrict its files:
      // storage.rules cannot read Firestore, so the bucket is gated only on the
      // ttlAccess claim. Closing that gap means serving files through a route
      // that checks canSeeOrder() first.

      // The ownership history, read through GET /api/orders/{id}/owners, which
      // checks the caller against the parent order first.
      //
      // Closed to the client SDK outright rather than gated on orderVisible():
      // inside this match `resource.data` is the event, not the order, so the
      // visibility helpers would test the wrong document — and because an event
      // carries no ownership fields at all, they would fall through to their
      // "nobody owns this" branch and hand every history to everyone. Route it;
      // do not try to express it here.
      match /ownerEvents/{eventId} {
        allow read, write: if false; // Admin SDK only
      }
    }

    match /agreements/{agreementId} {
      allow read: if isAllowedUser();
      allow write: if false; // written only by the Admin SDK (signing route)
    }

    match /signing_tokens/{token} {
      allow read, write: if false; // Admin SDK only — never touched by the client
    }

    // The order-number sequence, one document per year, advanced only by the
    // transaction in /api/orders/number through the Admin SDK. Closed to the
    // client outright: a client that could write the counter could wind it back
    // and put a number already printed on a rate confirmation onto a second
    // load. (An unmatched collection is denied anyway — this is here so the
    // reason is written down next to the rule.)
    match /counters/{counterId} {
      allow read, write: if false; // Admin SDK only
    }

    // Stored Google Routes mileage, so a lane is only ever billed once, plus
    // the log of admin-forced rechecks. Written only by /api/route-distance and
    // /api/route-distance/refresh through the Admin SDK. A client that could
    // write here could plant a mileage an invoice is built on.
    match /laneDistances/{laneId} {
      allow read, write: if false; // Admin SDK only

      // Subcollections are not covered by the parent match, so the refresh log
      // needs its own rule or it would fall through to the default.
      match /refreshes/{refreshId} {
        allow read, write: if false; // Admin SDK only
      }
    }

    // ---------------------------------------------------------------- chat
    //
    // Staff chat. Unlike everything above it, this is read live from the
    // browser rather than through an API route — see the note at the top of
    // src/lib/chat.ts for why that is safe here and is not for orders.
    //
    // Keep in sync with isConversationMember() in src/types/conversation.ts.

    // Is the caller in this conversation? The company room is the one everyone
    // is in, and carries no membership list to test — checking `kind` is what
    // grants it. Anything else is decided by the membership array, which only
    // /api/chat/conversations can write.
    function inConversation(convData) {
      return isAllowedUser() && (
        convData.kind == 'company'
        || request.auth.uid in convData.get('memberUids', [])
      );
    }

    function conversationData(convId) {
      return get(/databases/$(database)/documents/conversations/$(convId)).data;
    }

    match /conversations/{conversationId} {
      // `resource` is null when the document does not exist, and dereferencing
      // it there would deny the read rather than report it missing. That matters
      // for exactly one document: the company room is created on demand, and the
      // listener watching for it would otherwise report a permissions failure —
      // and be believed — on any database where nobody has opened chat yet.
      // Allowing the read of a document that is not there gives away nothing.
      allow read: if isAllowedUser() && (resource == null || inConversation(resource.data));

      // Brought into existence only by /api/chat/conversations, which verifies
      // every uid before it goes into a membership array. A client-side create
      // would let anyone write themselves a room naming whoever they liked.
      allow create, delete: if false;

      // The one client write allowed on a conversation: the preview line and
      // ordering stamp that a new message carries with it. It is written in
      // the same batch as the message (see sendMessage), because a message
      // that lands without moving its conversation up the list is a message
      // nobody is told about — and a second round trip through the server to
      // do it would show as a visible lag on every send.
      //
      // Everything that decides *access* — kind, memberUids — is excluded by
      // hasOnly, so this cannot be turned into a way into someone's room. The
      // sender is pinned to the caller so a preview cannot be put into another
      // person's mouth.
      //
      // `updatedAt` may be left exactly as it was or set to now, and nothing
      // else. Now, because a new message is new activity; unchanged, because
      // correcting a typo in the last message rewrites the preview and must
      // not shove a quiet conversation to the top of everyone's list.
      //
      // `lastMessage.at` is only checked for type. It is a preview stamp, and
      // the one thing it feeds — the unread badge — already ignores your own
      // messages, which is all this rule lets you write.
      //
      // `mentionedAt` is checked for type and nothing more. It drives a badge
      // on the reader's own screen and grants no access to anything; the worst
      // a member could do by writing a colleague's key is make an @ mark
      // appear or not appear for them. A stricter rule here would be more
      // machinery to get wrong, on a live database, guarding nothing.
      //
      // `reactionPings` is the second branch below, and is the only client
      // write here that carries no message with it. It is checked for type and
      // for being the only thing that moved, on the same reasoning as
      // `mentionedAt` and as the reactions themselves: it decides nothing, it
      // grants nothing, and the worst a member could do with it is make a
      // notification appear for a colleague who is already in the room with
      // them. Rules cannot read a map keyed by a uid they do not know, so
      // pinning the writer inside it is not something this could check anyway.
      allow update: if inConversation(resource.data) && (
        (
          request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['lastMessage', 'updatedAt', 'mentionedAt'])
          && request.resource.data.lastMessage.senderUid == request.auth.uid
          && request.resource.data.lastMessage.text is string
          && request.resource.data.lastMessage.text.size() <= 4000
          && request.resource.data.lastMessage.at is timestamp
          && (request.resource.data.updatedAt == request.time
              || request.resource.data.updatedAt == resource.data.updatedAt)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['mentionedAt'])
              || request.resource.data.mentionedAt is map)
        )
        // Reacting to somebody's message. `updatedAt` is deliberately not in
        // this list: a thumbs-up is not new activity, and letting it move the
        // stamp would shove a finished conversation back to the top of
        // everybody's list.
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionPings'])
          && request.resource.data.reactionPings is map
        )
        // Answering in a thread. `updatedAt` and `lastMessage` are both absent
        // from this list on purpose, and that absence is the whole feature: a
        // thread reply must not move the room up everybody's list or rewrite
        // the preview line, because the people it is for are told by this mark
        // and the people it is not for should never learn it happened.
        //
        // Checked for type and for being the only thing that moved, on the
        // same reasoning as `mentionedAt` and `reactionPings`: it decides
        // nothing and grants nothing, and rules cannot look inside a map keyed
        // by uids they do not know, so pinning the writer inside it is not
        // something this could check anyway.
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['threadPings'])
          && request.resource.data.threadPings is map
        )
        // Pinning a message to the top of the room, and unpinning one.
        //
        // Anybody in the room may do either, on anybody's message. These are
        // working rooms with no admin to appeal to — the same reasoning that
        // lets any member rename one — and a pin only its author could remove
        // is a pin that outlives them leaving the company.
        //
        // `updatedAt` is deliberately absent from the list, like the ping
        // branches above: pinning is not somebody speaking, and letting it
        // move the stamp would shove a finished room back to the top of
        // everybody's list.
        //
        // A map, not an array, which is what makes this safe to allow at all:
        // an array has to be written whole, so this rule would be letting any
        // member replace every pin in the room. Written at `pinned.<messageId>`
        // instead, one key at a time.
        //
        // Checked for type and for how many, and no further. Rules cannot walk
        // the values of a map, so the 200-character trim on the copied text
        // lives in pinMessage() alone — the same honest limit as `mentionedAt`,
        // `reactionPings` and `threadPings`, and with the same consequence: the
        // worst a member can do here is pin something silly in a room they are
        // already in, which anybody else in it can undo. Keep the count in step
        // with MAX_PINNED in src/types/conversation.ts.
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
          && request.resource.data.get('pinned', {}) is map
          && request.resource.data.get('pinned', {}).keys().size() <= 10
        )
      );

      // Subcollections are not covered by the parent match, so messages need
      // their own rule. Membership is re-read from the parent conversation —
      // rules cannot see it any other way, and Firestore caches the get()
      // across the documents of one query, so it costs one lookup, not one
      // per message.
      match /messages/{messageId} {
        allow read: if inConversation(conversationData(conversationId));

        // Sending. Pinned to the caller and to the server clock for the same
        // reasons as the preview above: nobody speaks in somebody else's name,
        // and nobody writes a message into last week.
        allow create: if inConversation(conversationData(conversationId))
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          // A photo on its own is a message. Only an empty box with nothing
          // attached to it is not, which is what this pair enforces.
          && (request.resource.data.text.size() > 0
              || request.resource.data.get('attachments', []).size() > 0)
          && request.resource.data.senderName is string
          && request.resource.data.createdAt == request.time
          // Defaulted, so a message written without the field still passes.
          && request.resource.data.get('mentions', []) is list
          && request.resource.data.get('attachments', []) is list;

        // Taking a message back, or correcting it — the sender only, either way.
        //
        // An edit is allowed but always leaves a mark: `editedAt` is pinned to
        // the server clock, and the thread shows "(edited)" beside it. That is
        // the honest version of the original rule here, which refused edits
        // outright on the grounds that a message somebody has acted on should
        // not silently become something else. Silently is the part that
        // mattered, and the mark is what removes it.
        //
        // An already-deleted message stays deleted: text that has been taken
        // back must not be able to reappear.
        allow update: if
          // Reacting — anybody in the conversation, on anybody's message.
          // That is the whole point: a thumbs-up you are not allowed to leave
          // on someone else's message is not a reaction.
          //
          // `reactions` is checked for type and for being the only thing that
          // moved. Rules cannot walk a map of arrays, so this does not prove
          // that the caller only added their own uid — among trusted staff the
          // worst case is a colleague's name appearing under a thumbs-up they
          // did not leave, and the check that matters, that no message text can
          // be touched down this branch, is the hasOnly.
          (
            inConversation(conversationData(conversationId))
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['reactions'])
            && request.resource.data.reactions is map
          )
          // The counters a thread reply carries with it, written in the same
          // batch as the reply itself. Anybody in the conversation may move
          // them, not only the message's own sender: the whole point is that
          // other people answer your message, and a count only its sender
          // could write is a count that never moves.
          //
          // `text` is not in the list, so nothing down this branch can touch
          // what the message says — which is the check that matters. The worst
          // a member could do with it is claim a thread has more replies in it
          // than it has, in a room they are already in.
          //
          // Nothing here proves a reply was actually written. Rules cannot see
          // the other writes in a batch, and a count that is one too high is
          // not worth machinery that could get a real reply refused.
          || (
            inConversation(conversationData(conversationId))
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['replyCount', 'lastReplyAt', 'replyUids'])
            && request.resource.data.replyCount is number
            && request.resource.data.lastReplyAt == request.time
            && request.resource.data.replyUids is list
          )
          // Correcting or taking back — the sender alone.
          || (
            isAllowedUser()
            && resource.data.senderUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['text', 'deletedAt', 'editedAt'])
            && (
              // Taking it back.
              (request.resource.data.text == ''
               && request.resource.data.deletedAt == request.time)
              // Correcting it.
              || (resource.data.get('deletedAt', null) == null
                  && request.resource.data.text is string
                  && request.resource.data.text.size() > 0
                  && request.resource.data.text.size() <= 4000
                  && request.resource.data.editedAt == request.time
                  && request.resource.data.get('deletedAt', null) == null)
            )
          );

        // The emptied document stays, so the thread does not reshuffle around
        // a hole underneath people who have already read it.
        allow delete: if false;
      }

      // Thread replies, in a collection beside the messages rather than under
      // them — see REPLIES_COLLECTION in src/types/conversation.ts for why.
      //
      // Everything here mirrors /messages above, deliberately: a reply is the
      // same object said in a narrower place, and the moment the two rule sets
      // drift a reply becomes something you can do things to that you cannot
      // do to a message. Membership of the room is the only gate, because a
      // thread is not a smaller room — anyone who can read the message can
      // read what was said under it.
      match /replies/{replyId} {
        allow read: if inConversation(conversationData(conversationId));

        allow create: if inConversation(conversationData(conversationId))
          && request.resource.data.senderUid == request.auth.uid
          // The message this hangs under. Its existence is not checked: that
          // would be a second document read on every reply to prove something
          // the writer had to have on screen to reply to at all, and a reply
          // pointing at nothing shows up nowhere.
          && request.resource.data.rootId is string
          && request.resource.data.rootId.size() > 0
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && (request.resource.data.text.size() > 0
              || request.resource.data.get('attachments', []).size() > 0)
          && request.resource.data.senderName is string
          && request.resource.data.createdAt == request.time
          && request.resource.data.get('mentions', []) is list
          && request.resource.data.get('attachments', []) is list;

        allow update: if
          // Reacting — anybody in the conversation, on anybody's reply.
          (
            inConversation(conversationData(conversationId))
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['reactions'])
            && request.resource.data.reactions is map
          )
          // Correcting or taking back — the sender alone. `rootId` is not in
          // the list, so a reply cannot be moved into a different thread after
          // the fact and turn up under a message nobody expected it under.
          || (
            isAllowedUser()
            && resource.data.senderUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['text', 'deletedAt', 'editedAt'])
            && (
              (request.resource.data.text == ''
               && request.resource.data.deletedAt == request.time)
              || (resource.data.get('deletedAt', null) == null
                  && request.resource.data.text is string
                  && request.resource.data.text.size() > 0
                  && request.resource.data.text.size() <= 4000
                  && request.resource.data.editedAt == request.time
                  && request.resource.data.get('deletedAt', null) == null)
            )
          );

        allow delete: if false;
      }
    }

    // What each person has read, one document per user, keyed by their uid.
    //
    // Self-service by design: it says nothing about access, only about which
    // conversations still show a badge for you. The uid in the path is what
    // stops one person clearing — or planting — another person's unread marks.
    match /chatReads/{uid} {
      allow read, write: if isAllowedUser() && request.auth.uid == uid;
    }

    // Every thread one person is in, kept as one document per thread at
    // chatThreads/{uid}/threads/{rootMessageId}.
    //
    // Keep in sync with CHAT_THREADS_COLLECTION in src/types/conversation.ts,
    // which explains why the list is written down rather than queried for.
    //
    // This is the one place in this file where somebody writes into a document
    // that belongs to another person, and it is deliberate: the row is put
    // there by whoever wrote the reply, because they are the only one present
    // at the moment it becomes true. So the write is bounded rather than
    // trusted — a row must name the writer as the author of the reply it
    // describes, and must name a room the writer is actually in. The worst a
    // member can manage is one wrong line in a colleague's list, which that
    // colleague can delete.
    //
    // A document each rather than a map on one document per person is what
    // makes that bound possible at all: a map would have to be written whole,
    // so allowing a reply would mean allowing the replier to overwrite the
    // entire list.
    match /chatThreads/{uid}/threads/{rootId} {
      // Nobody reads anybody else's list. Unlike the row-writing rule below,
      // there is no reason to soften this: the list is only ever rendered for
      // the person it belongs to.
      allow read: if isAllowedUser() && request.auth.uid == uid;

      allow create, update: if
        // The room named in the row, not the row's owner — see the note in
        // ThreadEntry. Somebody who has since been removed from a room can
        // still be sitting in the root message's replyUids, and refusing to
        // write their row would fail the whole reply batch rather than the one
        // row. Their list drops the thread at render instead, because the name
        // of a room they cannot open no longer resolves.
        inConversation(conversationData(request.resource.data.conversationId))
        // No writing a row that puts somebody else's name on your reply.
        && request.resource.data.lastReplyByUid == request.auth.uid
        // Server time, so a row cannot be backdated to bury itself or
        // postdated to pin itself to the top of a colleague's list for good.
        && request.resource.data.lastReplyAt == request.time
        && request.resource.data.rootId == rootId
        && request.resource.data.conversationId is string
        && request.resource.data.rootSenderUid is string
        && request.resource.data.lastReplyByName is string
        && request.resource.data.mention is bool
        // Both are previews trimmed to 120 at the write. Capped again here so
        // a row cannot be used to park four thousand characters in somebody
        // else's list.
        && request.resource.data.rootText is string
        && request.resource.data.rootText.size() <= 120
        && request.resource.data.lastReplyText is string
        && request.resource.data.lastReplyText.size() <= 120;

      // Only the owner clears a row, and only their own. A reply that puts the
      // thread back is the intended behaviour, not a bug — see dismissThread.
      allow delete: if isAllowedUser() && request.auth.uid == uid;
    }
  }
}
